-- 3. HÀM TÌM VICIOUS BEE HOẶC GAI (BẮT LEVEL CHUẨN XÁC)
local function findVicious(minLvl)
    minLvl = minLvl or 1
    local monsters = workspace:FindFirstChild("Monsters")
    if not monsters then return nil, 0 end
    
    for _, v in ipairs(monsters:GetChildren()) do
        if v.Name:find("Vicious Bee") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then 
                -- Đọc chuẩn Level từ chuỗi (Ví dụ "Vicious Bee (Lvl 8)" hoặc "Vicious Bee 8")
                local lvlStr = v.Name:match("%(Lvl%s*(%d+)%)") or v.Name:match("(%d+)")
                local lvl = tonumber(lvlStr) or 1
                
                if lvl >= minLvl then
                    return v, lvl 
                end
            end
        end
    end
    return nil, 0
end

local function findThorn()
    local wts = workspace:FindFirstChild("Particles") and workspace.Particles:FindFirstChild("WTs")
    if not wts then return nil end
    for _, v in ipairs(wts:GetChildren()) do
        if v.Name == "WaitingThorn" then return v end
    end
    return nil
end

-- HÀM LẤY MINLEVEL TỪ CLOUD
local function getMinLevelFromCloud()
    local minLvl = 1
    if not httpRequest then return minLvl end
    pcall(function()
        local getRes = httpRequest({
            Url = JSONBIN_URL,
            Method = "GET",
            Headers = {["X-Master-Key"] = JSONBIN_KEY, ["X-Access-Key"] = JSONBIN_KEY}
        })
        if getRes and getRes.StatusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            if data.record and data.record.minLevel then
                minLvl = tonumber(data.record.minLevel) or 1
            end
        end
    end)
    return minLvl
end

-- 4. HÀM GỬI & XÓA DỮ LIỆU TÍN HIỆU TẠI CLOUD
local function pushToCloud()
    if not httpRequest then return end
    pcall(function()
        local getRes = httpRequest({
            Url = JSONBIN_URL,
            Method = "GET",
            Headers = {["X-Master-Key"] = JSONBIN_KEY, ["X-Access-Key"] = JSONBIN_KEY}
        })
        
        local queue = {}
        local minLvl = 1
        if getRes and getRes.StatusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            if data.record then
                if type(data.record.queue) == "table" then queue = data.record.queue end
                if data.record.minLevel then minLvl = data.record.minLevel end
            end
        end

        table.insert(queue, {
            jobid = tostring(game.JobId),
            userid = tostring(player.UserId),
            timestamp = os.time()
        })

        httpRequest({
            Url = JSONBIN_URL,
            Method = "PUT",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Master-Key"] = JSONBIN_KEY,
                ["X-Access-Key"] = JSONBIN_KEY
            },
            Body = Http:JSONEncode({ minLevel = minLvl, queue = queue })
        })
    end)
end

local function removeFromCloud()
    if not httpRequest then return end
    pcall(function()
        local getRes = httpRequest({
            Url = JSONBIN_URL,
            Method = "GET",
            Headers = {["X-Master-Key"] = JSONBIN_KEY, ["X-Access-Key"] = JSONBIN_KEY}
        })
        
        if getRes and getRes.StatusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            local queue = (data.record and data.record.queue) or {}
            local minLvl = (data.record and data.record.minLevel) or 1
            local newQueue = {}

            for _, item in ipairs(queue) do
                if item.jobid ~= game.JobId then
                    table.insert(newQueue, item)
                end
            end

            httpRequest({
                Url = JSONBIN_URL,
                Method = "PUT",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["X-Master-Key"] = JSONBIN_KEY,
                    ["X-Access-Key"] = JSONBIN_KEY
                },
                Body = Http:JSONEncode({ minLevel = minLvl, queue = newQueue })
            })
        end
    end)
end

-- 5. HÀM SERVER HOP CHỐNG LẶP SERVER CŨ
local blacklistedServers = {}

local function serverHop()
    updateStatus("🚀 Đang chuyển Server mới...", Color3.fromRGB(255, 200, 50))
    local placeId = game.PlaceId
    if game.JobId ~= "" then blacklistedServers[game.JobId] = tick() end

    local cursor = ""
    local attempts = 0

    while attempts < 5 do
        attempts = attempts + 1
        local success = pcall(function()
            local url = "https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and ("&cursor="..cursor) or "")
            local req = game:HttpGet(url)
            local data = Http:JSONDecode(req)
            
            if data and data.nextPageCursor then cursor = data.nextPageCursor end

            local validServers = {}
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if not blacklistedServers[s.id] and s.playing and s.maxPlayers and s.playing < math.floor(s.maxPlayers * 0.8) then
                        table.insert(validServers, s)
                    end
                end
            end

            if #validServers > 0 then
                local picked = validServers[math.random(1, #validServers)]
                blacklistedServers[picked.id] = tick()
                TeleportService:TeleportToPlaceInstance(placeId, picked.id, player)
                task.wait(6)
            end
        end)

        if not success then
            task.wait(1.5)
        end
    end

    pcall(function()
        TeleportService:Teleport(placeId, player)
    end)
end

