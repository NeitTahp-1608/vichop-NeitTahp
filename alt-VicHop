-- 3. HÀM TÌM VICIOUS BEE HOẶC GAI
local function findVicious(minLvl)
    minLvl = minLvl or 1
    local monsters = workspace:FindFirstChild("Monsters")
    if not monsters then return nil, 0 end
    
    for _, v in ipairs(monsters:GetChildren()) do
        if v.Name:find("Vicious Bee") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then 
                local lvlStr = v.Name:match("%(Lvl%s*(%d+)%)") or v.Name:match("(%d+)")
                local lvl = tonumber(lvlStr) or 1
                
                if lvl >= minLvl then
                    return v, lvl 
                end
            end
        end
    end
    return nil, 0
end

local function findThorn()
    local wts = workspace:FindFirstChild("Particles") and workspace.Particles:FindFirstChild("WTs")
    if not wts then return nil end
    for _, v in ipairs(wts:GetChildren()) do
        if v.Name == "WaitingThorn" then return v end
    end
    return nil
end

-- HÀM LẤY MINLEVEL TỪ CLOUD (CÓ CHỐNG LỖI 429)
local function getMinLevelFromCloud()
    local minLvl = 1
    if not httpRequest or isRateLimited then return minLvl end
    pcall(function()
        local getRes = httpRequest({
            Url = JSON_URL,
            Method = "GET",
            Headers = { ["x-api-key"] = API_KEY }
        })
        local statusCode = getRes and (getRes.StatusCode or getRes.Status)
        if statusCode == 429 then
            isRateLimited = true
            updateStatus("⏳ Quá tải API! Tạm nghỉ 15s...", Color3.fromRGB(255, 150, 50))
            task.wait(15)
            isRateLimited = false
        elseif getRes and statusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            if data and data.minLevel then
                minLvl = tonumber(data.minLevel) or 1
            end
        end
    end)
    return minLvl
end

-- 4. HÀM GỬI & XÓA DỮ LIỆU TẠI CLOUD (JSONSTORAGE)
local function pushToCloud()
    if not httpRequest or isRateLimited then return end
    pcall(function()
        local getRes = httpRequest({
            Url = JSON_URL,
            Method = "GET",
            Headers = { ["x-api-key"] = API_KEY }
        })
        
        local statusCode = getRes and (getRes.StatusCode or getRes.Status)
        if statusCode == 429 then
            isRateLimited = true
            task.wait(15)
            isRateLimited = false
            return
        end

        local queue = {}
        local minLvl = 1
        if statusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            if data then
                if type(data.queue) == "table" then queue = data.queue end
                if data.minLevel then minLvl = data.minLevel end
            end
        end

        -- Kiểm tra xem đã có JobId này chưa để tránh chèn trùng
        local exists = false
        for _, item in ipairs(queue) do
            if item.jobid == tostring(game.JobId) then
                exists = true
                break
            end
        end

        if not exists then
            table.insert(queue, {
                jobid = tostring(game.JobId),
                userid = tostring(player.UserId),
                timestamp = os.time()
            })

            httpRequest({
                Url = JSON_URL,
                Method = "PUT",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["x-api-key"] = API_KEY
                },
                Body = Http:JSONEncode({ minLevel = minLvl, queue = queue })
            })
        end
    end)
end

local function removeFromCloud()
    if not httpRequest or isRateLimited then return end
    pcall(function()
        local getRes = httpRequest({
            Url = JSON_URL,
            Method = "GET",
            Headers = { ["x-api-key"] = API_KEY }
        })
        
        local statusCode = getRes and (getRes.StatusCode or getRes.Status)
        if statusCode == 200 then
            local data = Http:JSONDecode(getRes.Body)
            local queue = (data and data.queue) or {}
            local minLvl = (data and data.minLevel) or 1
            local newQueue = {}

            for _, item in ipairs(queue) do
                if item.jobid ~= tostring(game.JobId) then
                    table.insert(newQueue, item)
                end
            end

            httpRequest({
                Url = JSON_URL,
                Method = "PUT",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["x-api-key"] = API_KEY
                },
                Body = Http:JSONEncode({ minLevel = minLvl, queue = newQueue })
            })
        end
    end)
end

-- 5. HÀM SERVER HOP CHỐNG LẶP SERVER CŨ
local blacklistedServers = {}

local function serverHop()
    updateStatus("🚀 Đang chuyển Server mới...", Color3.fromRGB(255, 200, 50))
    local placeId = game.PlaceId
    if game.JobId ~= "" then blacklistedServers[game.JobId] = tick() end

    local cursor = ""
    local attempts = 0

    while attempts < 5 do
        attempts = attempts + 1
        local success = pcall(function()
            local url = "https://games.roblox.com/v1/games/"..placeId.."/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and ("&cursor="..cursor) or "")
            local req = game:HttpGet(url)
            local data = Http:JSONDecode(req)
            
            if data and data.nextPageCursor then cursor = data.nextPageCursor end

            local validServers = {}
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if not blacklistedServers[s.id] and s.playing and s.maxPlayers and s.playing < math.floor(s.maxPlayers * 0.8) then
                        table.insert(validServers, s)
                    end
                end
            end

            if #validServers > 0 then
                local picked = validServers[math.random(1, #validServers)]
                blacklistedServers[picked.id] = tick()
                TeleportService:TeleportToPlaceInstance(placeId, picked.id, player)
                task.wait(6)
            end
        end)

        if not success then
            task.wait(1.5)
        end
    end

    pcall(function()
        TeleportService:Teleport(placeId, player)
    end)
end

